#include <stdio.h>
#include <string.h>

int main()
{
    char a[20], b[20], sum[21], checksum[21];
    int len, i, carry = 0, temp;

    scanf("%s", a);
    scanf("%s", b);

    len = strlen(a);

    sum[len + 1] = '\0';

    /* Binary Addition */
    for(i = len - 1; i >= 0; i--)
    {
        temp = (a[i] - '0') + (b[i] - '0') + carry;
        sum[i + 1] = (temp % 2) + '0';
        carry = temp / 2;
    }

    sum[0] = carry + '0';

    /* 1's Complement (Checksum) */
    for(i = 0; i <= len; i++)
    {
        if(sum[i] == '1')
            checksum[i] = '0';
        else
            checksum[i] = '1';
    }

    checksum[len + 1] = '\0';

    printf("Binary addition: A = %s B = %s Sum = %s Checksum = %s\n", a, b, sum, checksum);
    printf("Verification (receiver adds data + checksum): If result is all 1s \u2192 1's complement = all 0s \u2192 no error.");

    return 0;
}
